# ==============================================================================
# PSYCODES STUDIO // ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholder values with your real keys.
# ==============================================================================

# Supabase Project URL & Anonymous Key (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional Site Metadata
VITE_SITE_URL=https://www.psycodestudio.tech
VITE_STUDIO_EMAIL=psycodestech@gmail.com

# Resend API Key for automated client order receipts & studio lead dispatch
# Get a free API key (3,000 emails/month) at https://resend.com
VITE_RESEND_API_KEY=re_your_api_key_here
VITE_RESEND_FROM_EMAIL=PsyCodes Studio <onboarding@resend.dev>
